<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Asteria.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src/Asteria.Core/**/*.cs" />
    <Compile Remove="src/Asteria.Core.Tests/**/*.cs" />
    <!-- Separate mod ABI assembly; compiling it into the Godot project
         duplicates ABI types and generated assembly attributes. -->
    <Compile Remove="src/Asteria.ModAPI/**/*.cs" />
    <Compile Remove="tools/WorldgenBenchmark/**/*.cs" />
    <Compile Remove="tools/BiomeMap/**/*.cs" />
    <ProjectReference Include="src/Asteria.Core/Asteria.Core.csproj" />
    <ProjectReference Include="src/Asteria.ModAPI/Asteria.ModAPI.csproj" />
  </ItemGroup>

  <!-- Internal default pack: compiled into the managed assembly, not
       distributed as an externally editable pack directory. -->
  <ItemGroup>
    <EmbeddedResource Include="packs/default/**/*"
                      Exclude="packs/default/**/*.uid;packs/default/**/*.import;packs/default/**/*.gdignore">
      <LogicalName>asteria.pack.default/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>


  <!-- Embed the commit of the assembly actually compiled, not the HEAD at runtime.
       The module MVID in diagnostics also distinguishes builds with local edits. -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)AsteriaBuildIdentity.g.cs" />
  </ItemGroup>

  <Target Name="EmbedAsteriaBuildIdentity" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --verify HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_AsteriaBuildCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_AsteriaBuildGitExitCode" />
    </Exec>
    <PropertyGroup>
      <_AsteriaBuildCommit Condition="'$(_AsteriaBuildGitExitCode)' != '0' Or '$(_AsteriaBuildCommit)' == ''">unknown</_AsteriaBuildCommit>
    </PropertyGroup>
    <WriteLinesToFile
        File="$(IntermediateOutputPath)AsteriaBuildIdentity.g.cs"
        Lines="namespace Asteria.Client { internal static class AsteriaBuildIdentity { internal const string Commit = &quot;$(_AsteriaBuildCommit)&quot;%3B } }"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
