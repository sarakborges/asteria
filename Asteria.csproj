<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Asteria.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src/Asteria.Core/**/*.cs" />
    <Compile Remove="src/Asteria.Core.Tests/**/*.cs" />
    <Compile Remove="tools/WorldgenBenchmark/**/*.cs" />
    <Compile Remove="tools/BiomeMap/**/*.cs" />
    <ProjectReference Include="src/Asteria.Core/Asteria.Core.csproj" />
  </ItemGroup>

  <!-- Internal default pack: compiled into the managed assembly, not
       distributed as an externally editable pack directory. -->
  <ItemGroup>
    <EmbeddedResource Include="packs/default/**/*"
                      Exclude="packs/default/**/*.uid;packs/default/**/*.import;packs/default/**/*.gdignore">
      <LogicalName>asteria.pack.default/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
